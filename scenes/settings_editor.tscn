[ext_resource type="Script" uid="uid://cm8o5xfsgiy0q" path="res://scripts/settings_editor.gd" id="2"]

[node name="settings_editor" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("2")

[node name="buttons" type="HBoxContainer" parent="."]
layout_mode = 2
alignment = 2

[node name="close" type="Button" parent="buttons"]
layout_mode = 2
text = "✖"

[node name="settings_container" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="library_path" parent="settings_container" instance=ExtResource("1")]
layout_mode = 2
setting_name = "library_path"
setting_description = "Path to dingsda document library."

[node name="content_scale" type="HBoxContainer" parent="settings_container"]
layout_mode = 2

[node name="Label" type="Label" parent="settings_container/content_scale"]
layout_mode = 2
text = "UI Scale"

[node name="scale" type="OptionButton" parent="settings_container/content_scale"]
layout_mode = 2
selected = 0
item_count = 5
popup/item_0/text = "100%"
popup/item_0/id = 0
popup/item_1/text = "125%"
popup/item_1/id = 1
popup/item_2/text = "150%"
popup/item_2/id = 2
popup/item_3/text = "175%"
popup/item_3/id = 3
popup/item_4/text = "200%"
popup/item_4/id = 4

[connection signal="pressed" from="buttons/close" to="." method="_on_close_pressed"]
[connection signal="path_changed" from="settings_container/library_path" to="." method="_on_library_path_path_changed"]
[connection signal="item_selected" from="settings_container/content_scale/scale" to="." method="_on_scale_item_selected"]
